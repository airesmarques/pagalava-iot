[Unit]
Description=PagaLava first-boot provisioning
# local-fs.target guarantees the boot partition is mounted; without it the
# provisioning file may simply not be visible yet and the device would come up
# unconfigured for no discoverable reason.
After=local-fs.target
Requires=local-fs.target
# Provisioning writes the .env that receive_messages.service reads at startup,
# so it has to win the race against it on every boot, not just the first.
Before=receive_messages.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/pagalava/pagalava-iot/firstboot.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
